DATABASE_URL=postgres://clinicflow:clinicflow_dev@127.0.0.1:5433/clinicflow

# URL pública de la app (para links en emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email: Resend (https://resend.com). Sin key, los envíos fallan con email_no_configurado.
RESEND_API_KEY=
# Remitente verificado en Resend. Ej: RESEND_FROM="Clínica Sol <no-reply@tu-dominio.com>"
RESEND_FROM=

# Modo de envío de email: "resend" (por defecto, requiere RESEND_API_KEY y RESEND_FROM)
# o "smtp-dev" (SMTP directo a Mailpit en desarrollo, sin RESEND_API_KEY).
# Con smtp-dev la bandeja de correo está en http://localhost:8026
# (docker compose up mailpit).
MAIL_MODE=resend
# Host y puerto SMTP de Mailpit (solo se usan cuando MAIL_MODE=smtp-dev)
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1026

# Cron interno (recordatorios, renovaciones, fiscal, digest, recall, seguimiento).
# Todos los endpoints verifican este secreto. Sin él (o con valor vacío) los
# /api/cron/* responden 401 siempre (fail-closed). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
# El planificador externo (tarea programada / cron del servidor) hace POST a estas URLs
# con el header Authorization: Bearer $CRON_SECRET. scripts/instalar-cron.ps1 registra
# dos tareas de Windows: OfCron (cada hora) y OfCronDiario (08:00). Ejemplo manual:
#   $h = @{ Authorization = "Bearer $env:CRON_SECRET" }
#   Invoke-RestMethod -Method Post -Uri http://localhost:3112/api/cron/recordatorios -Headers $h
#   Invoke-RestMethod -Method Post -Uri http://localhost:3112/api/cron/renovaciones -Headers $h
#   Invoke-RestMethod -Method Post -Uri http://localhost:3112/api/cron/fiscal -Headers $h
#   Invoke-RestMethod -Method Post -Uri http://localhost:3112/api/cron/diario -Headers $h
#   Invoke-RestMethod -Method Post -Uri http://localhost:3112/api/cron/recall -Headers $h
#   Invoke-RestMethod -Method Post -Uri http://localhost:3112/api/cron/seguimiento -Headers $h
RECORDATORIOS_CRON_URL=http://localhost:3112/api/cron/recordatorios
RENOVACIONES_CRON_URL=http://localhost:3112/api/cron/renovaciones

# Emails separados por coma con acceso al panel /admin (planes y suscripciones)
ADMIN_EMAILS=owner@demo.clinicflow.pe

# Clave maestra para cifrar secretos en reposo (fiscal/WhatsApp). Mínimo 32 chars en producción.
LOCAL_MASTER_KEY=

# Sidecar Greenter/lycet para facturación SUNAT (docker compose up lycet). Sin LYCET_URL la emisión indica lycet_no_configurado.
LYCET_URL=http://127.0.0.1:8091
# Token del sidecar lycet (CLIENT_TOKEN del contenedor; default 123456)
LYCET_TOKEN=

# Webhook de WhatsApp (verificación de Meta). El token y phone id se configuran desde consola y se cifran en DB.
WHATSAPP_VERIFY_TOKEN=

# Base de la WhatsApp Cloud API para enviar mensajes (enviarWhatsApp/enviarPlantillaWhatsApp).
# Default: endpoint real de Meta. En dev, para ensayar el bot sin Meta, levantar whatsmock
# (scripts\setup-whatsmock.ps1, mock local estilo Mailpit) y usar:
#   WHATSAPP_BASE_URL=http://127.0.0.1:3010/v22.0
WHATSAPP_BASE_URL=https://graph.facebook.com/v19.0

# Política de respuesta del bot de WhatsApp entrante (Fase 4, pricing por mensaje de Meta):
#   silent : procesa keywords (CONFIRMAR/REPROGRAMAR/CANCELAR) y actualiza la cita,
#            pero NO envía ninguna respuesta por WhatsApp (solo audit).
#   single : (default) máximo 1 mensaje de texto por mensaje entrante, con el link
#            web de la clínica (/{slug}/reserva y/o magic link de gestionar).
#            La conversación completa ocurre gratis en la web.
#   full   : comportamiento legado conversacional detallado.
WA_REPLY_MODE=single

# Directorio de archivos adjuntos (por defecto .data/attachments)
ATTACHMENTS_DIR=
