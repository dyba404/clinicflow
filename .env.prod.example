# ============================================================================
# Clinicflow — producción (docker-compose.prod.yml)
# Copia este archivo a `.env` junto al compose y completa TODOS los valores.
# Sin las variables obligatorias el `docker compose up` falla a propósito
# (sintaxis ${VAR:?mensaje}) para no desplegar con secretos por defecto.
# ============================================================================

# --- Obligatorios: el deploy falla si faltan ------------------------------

# Contraseña de Postgres del contenedor db (solo red interna, no se publica el puerto).
# Genera una con:  openssl rand -hex 24   (o: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))")
POSTGRES_PASSWORD=

# Secreto Bearer que usa el contenedor cron para llamar /api/cron/*.
# Debe ser aleatorio y fuerte; nunca dejes valores de ejemplo.
CRON_SECRET=

# Clave maestra AES-256-GCM para cifrar en reposo: Clave SOL, certificado
# fiscal, token de WhatsApp. UNA vez definida, NUNCA la cambies: no hay
# rotación y la nueva clave dejaría ilegibles los secretos ya guardados.
LOCAL_MASTER_KEY=

# URL pública de la app (links de correo, portal, WhatsApp y webhook).
# Ej: https://app.clinicflow.pe
NEXT_PUBLIC_APP_URL=

# Token del sidecar lycet (Greenter/SUNAT). Cambia el default 123456.
LYCET_TOKEN=

# --- Opcionales -----------------------------------------------------------

# Usuario/BD de Postgres (defaults clinicflow/clinicflow)
POSTGRES_USER=clinicflow
POSTGRES_DB=clinicflow

# Host de Postgres si vive fuera del compose (default: servicio db interno)
# DATABASE_HOST=db

# Puerto publicado de la app (default 3111; detrás de un reverse proxy HTTPS
# como Caddy/Nginx puedes dejarlo en localhost)
# WEB_PORT=3111

# Email (Resend). Sin estas variables el envío de correos se degrada:
# las acciones quedan en cola con email_no_configurado (no rompen la app).
RESEND_API_KEY=
RESEND_FROM=

# Modo de email: resend (producción). smtp-dev solo existe en docker-compose.yml (dev).
MAIL_MODE=resend

# Política del bot de WhatsApp entrante: silent | single | full
WA_REPLY_MODE=single

# Número Yape/Plin para pago QR por conciliación (si se usa)
YAPE_PLIN_NUMBER=

# Correos con acceso al panel /admin (separados por coma)
ADMIN_EMAILS=

# Token de verificación del webhook de WhatsApp (verificación de Meta)
WHATSAPP_VERIFY_TOKEN=

# Modo de emisión fiscal por tenant se configura desde la consola; aquí solo
# aseguras que LYCET_TOKEN coincida con el del sidecar. La app apunta al
# servicio interno http://lycet:8000 automáticamente.
